<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-rename-credentials" author="alesia">
        <renameTable oldTableName="user_credentials" newTableName="credentials"/>
        <renameColumn tableName="credentials" oldColumnName="login" newColumnName="username"/>
        <renameColumn tableName="credentials" oldColumnName="password" newColumnName="password_hash"/>
    </changeSet>
</databaseChangeLog>